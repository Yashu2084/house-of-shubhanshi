# ==============================================================================
# HOUSE OF SHUBHANSHI — BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port
PORT=3001

# Node Environment ('development' | 'production')
NODE_ENV=development

# Frontend Storefront URL
FRONTEND_URL=https://houseofshubhanshi.com

# PostgreSQL Connection String (Prisma / pg format)
# E.g. postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/house_of_shubhanshi?schema=public"

# JWT Secret Key for Secure Cookie Tokens
JWT_SECRET="house_of_shubhanshi_super_secret_jwt_key_2026_dev"

# Cookie Max Age in Milliseconds (7 days = 604800000 ms)
COOKIE_EXPIRES_IN_MS=604800000

# Default Admin Seed Credentials (Used during database seed)
ADMIN_NAME="House of Shubhanshi Atelier"
ADMIN_EMAIL="admin@houseofshubhanshi.com"
ADMIN_PASSWORD="Admin@Shubhanshi2026!"
ADMIN_PHONE="+91 9560011351"
